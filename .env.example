# Required for model calls. Add real credentials only to your local .env or secret manager.
MESH_API_KEY=rsk_your_mesh_key
MESH_MODEL=openai/gpt-oss-120b
# MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_BASE_URL=https://api.meshapi.ai/v1

# Required for live web search.
TAVILY_API_KEY=tvly_your_key

# Optional Qdrant Cloud semantic evidence index. Leave blank to disable Qdrant.
QDRANT_URL=https://6c22db98-9534-4241-88bb-b8fc64715477.ca-central-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_key
QDRANT_COLLECTION=deepdive
QDRANT_TOP_K=8

# Optional Redis exact-response cache and follow-up memory. Leave blank to disable.
REDIS_URL=
LLM_CACHE_TTL_SECONDS=1800
REDIS_MEMORY_TTL_SECONDS=2592000
REDIS_MEMORY_MAX_RUNS=5

# Application configuration
DATABASE_PATH=data/deepdive.sqlite3
MAX_RESEARCH_ROUNDS=2
MAX_SUBQUESTIONS=5
MAX_SEARCH_RESULTS_PER_QUERY=5
REQUEST_TIMEOUT_SECONDS=30

# Use a random secret of at least 32 characters in staging/production.
DEEPDIVE_API_KEY=replace-with-your-local-development-key
MAX_CONCURRENT_RESEARCH_RUNS=2
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
